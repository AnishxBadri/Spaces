__unconfig*
todos.json

# turbo's local cache + per-task logs (no remote cache; the cache is this box)
.turbo

# runtime data (blobs + secret.key)
data/

# backup.sh output — a dump and every blob, never in git
backups/

# Playwright's per-run output (traces, the saved admin session) — CI uploads
# it as an artifact on failure; it is never source (SPA-184)
apps/e2e/test-results/
apps/e2e/playwright-report/

# apps/site's copies of docs/assets, made by src/integrations/sync-assets.ts
# on every dev and build; docs/assets is the one place they live. And Astro's
# generated type declarations (`astro sync` / `astro check`).
apps/site/public/screenshots/
apps/site/public/logo.svg
apps/site/public/logo-dark.svg
apps/site/public/mark.svg
apps/site/.astro/

# NOT docs/ — an over-broad `docs/*` rule landed here 2026-09-07 inside an
# unrelated commit and silently stopped the decision record from being
# committed (CONTEXT.md and ARCHITECTURE.md point at specs that were never
# tracked). docs/ is the decision record; it belongs in git.

# scratch research: screenshots, surveys-in-progress, pasted source material
research/

# agent worktrees (separate checkouts, never committed from here)
.claude/worktrees/
