{
  "name": "spaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./apps/web/src/*"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "generate-routes": "turbo run generate-routes",
    "test": "turbo run test test:root",
    "e2e": "turbo run e2e",
    "screenshots": "turbo run screenshots",
    "lint": "turbo run lint lint:root",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint:root": "eslint scripts --no-error-on-unmatched-pattern",
    "typecheck:root": "tsc --noEmit",
    "test:root": "vitest run --config scripts/vitest.config.ts",
    "worker": "pnpm --filter @spaces/worker worker",
    "preview": "pnpm --filter @spaces/web preview",
    "db:migrate:run": "pnpm --filter @spaces/web db:migrate:run",
    "db:seed": "pnpm --filter @spaces/web db:seed",
    "db:generate": "pnpm --filter @spaces/db db:generate",
    "db:migrate": "pnpm --filter @spaces/db db:migrate",
    "db:push": "pnpm --filter @spaces/db db:push",
    "db:pull": "pnpm --filter @spaces/db db:pull",
    "db:studio": "pnpm --filter @spaces/db db:studio",
    "changeset": "changeset",
    "release:status": "tsx scripts/changeset-version.ts --status",
    "release:version": "tsx scripts/changeset-version.ts",
    "release:tag": "tsx scripts/release-tags.ts --push",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/apply-release-plan": "^8.1.1",
    "@changesets/assemble-release-plan": "^7.0.0",
    "@changesets/cli": "^3.0.3",
    "@changesets/config": "^4.0.1",
    "@changesets/read": "^1.0.1",
    "@changesets/types": "^7.0.0",
    "@manypkg/get-packages": "^3.1.0",
    "@spaces/config": "workspace:*",
    "@spaces/core": "workspace:*",
    "@spaces/db": "workspace:*",
    "@spaces/sdk": "workspace:*",
    "@types/node": "^22.10.2",
    "effect": "4.0.0-rc.112",
    "eslint": "^9.20.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "turbo": "2.11.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
