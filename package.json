{
  "name": "spaces",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./apps/web/src/*"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "generate-routes": "turbo run generate-routes",
    "test": "turbo run test",
    "lint": "turbo run lint lint:root",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint:root": "eslint eslint-rules scripts --no-error-on-unmatched-pattern",
    "typecheck:root": "tsc --noEmit",
    "worker": "pnpm --filter @spaces/web worker",
    "preview": "pnpm --filter @spaces/web preview",
    "db:migrate:run": "pnpm --filter @spaces/web db:migrate:run",
    "db:seed": "pnpm --filter @spaces/web db:seed",
    "db:generate": "pnpm --filter @spaces/web db:generate",
    "db:migrate": "pnpm --filter @spaces/web db:migrate",
    "db:push": "pnpm --filter @spaces/web db:push",
    "db:pull": "pnpm --filter @spaces/web db:pull",
    "db:studio": "pnpm --filter @spaces/web db:studio",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@spaces/config": "workspace:*",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.20.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.11.2",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
