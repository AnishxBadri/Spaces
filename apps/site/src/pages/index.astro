---
import Base from '../layouts/Base.astro'
import Scaled from '../components/Scaled.astro'
import Shot from '../components/Shot.astro'
import Detail from '../components/Detail.astro'
import Orbit from '../components/Orbit.astro'
import {
  CHAPTERS,
  CLOSING,
  CLOSING_COPY,
  HERO,
  HERO_COPY,
  HERO_SHOTS,
  ORBIT_HEAD,
} from '../content/landing'
import { plateUrl } from '../dither/stages'
import { GITHUB } from '../links'
---

<Base
  title="Spaces, the deal book you run yourself"
  description="Open-source, self-hosted deal management for angels and small funds. Your box, your data, your keys."
>
  <main>
    <section class="hero" aria-labelledby="hero-h">
      <div class="hero-copy wrap">
        <p class="eyebrow">{HERO_COPY.eyebrow}</p>
        <h1 id="hero-h" class="serif">{HERO_COPY.title}</h1>
        <p class="sub">{HERO_COPY.sub}</p>
        <div class="actions">
          <a class="go" href="/docs/self-host">{HERO_COPY.primary}</a>
          <a class="under" href={GITHUB}>{HERO_COPY.secondary}</a>
        </div>
      </div>
      <div class="wrap">
        <Scaled width={HERO.width} height={HERO.height} plate={HERO.name}>
          {
            HERO_SHOTS.map((shot, i) => (
              <Shot shot={shot} z={i + 1} eager priority={i === 0} />
            ))
          }
        </Scaled>
      </div>
    </section>

    <section id="how-it-works" class="how" aria-labelledby="how-h">
      <header class="how-head">
        <p class="eyebrow">{ORBIT_HEAD.eyebrow}</p>
        <h2 id="how-h" class="serif">{ORBIT_HEAD.title}</h2>
        <p class="lede">{ORBIT_HEAD.body}</p>
      </header>
      <div class="figure">
        <Orbit />
      </div>
    </section>

    <div class="chapters wrap">
      {
        CHAPTERS.map((c, i) => (
          <section
            id={c.id}
            class:list={['chapter', { flip: i % 2 === 1 }]}
            aria-labelledby={`${c.id}-h`}
          >
            <div class="chapter-copy">
              <p class="eyebrow">{c.eyebrow}</p>
              <h2 id={`${c.id}-h`} class="serif">
                {c.title}
              </h2>
              <p class="chapter-body">{c.body}</p>
              <ul class="proof">
                {c.proof.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
            <div class="chapter-stage">
              <Scaled
                width={c.stage.width}
                height={c.stage.height}
                plate={c.stage.name}
              >
                <Shot shot={c.shot} z={1} />
                <Detail detail={c.detail} />
              </Scaled>
            </div>
          </section>
        ))
      }
    </div>

    <section id="self-host" class="closing wrap" aria-labelledby="close-h">
      <div
        class="closing-plate"
        style={[
          `--plate:url(${plateUrl(CLOSING.name)})`,
          `--plate-b:url(${plateUrl(`${CLOSING.name}-b`)})`,
        ].join(';')}
      >
        <div class="close-card">
          <h2 id="close-h" class="serif">{CLOSING_COPY.title}</h2>
          <pre
            class="install"><code>{CLOSING_COPY.install.join('\n')}</code></pre>
          <div class="actions">
            <a class="go small" href="/docs/self-host">{CLOSING_COPY.primary}</a
            >
            <a class="under" href="/docs/self-host">{CLOSING_COPY.secondary}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ---- shared ---- */
  .eyebrow {
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-feature-settings: normal;
    font-variant-ligatures: none;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 16px;
    text-transform: uppercase;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
  }
  .go {
    padding: 11px 20px;
    border-radius: var(--radius);
    background: var(--pine);
    color: #ffffff;
    font-size: var(--text-title);
    font-weight: 500;
    line-height: 18px;
    text-decoration: none;
    white-space: nowrap;
  }
  .go.small {
    padding: 10px 18px;
  }
  .go:hover {
    background: var(--pine-hover);
  }
  .under {
    padding-bottom: 1px;
    border-bottom: 1px solid var(--hairline);
    color: var(--hairline);
    font-size: var(--text-title);
    line-height: 18px;
    text-decoration: none;
    white-space: nowrap;
  }
  .under:hover {
    border-bottom-width: 2px;
    padding-bottom: 0;
  }

  /* ---- hero ---- */
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding-block: 96px 56px;
    text-align: center;
  }
  .hero h1 {
    max-width: 880px;
    color: var(--hairline);
    font-size: 64px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 70px;
    text-wrap: balance;
  }
  .sub {
    max-width: 660px;
    color: var(--graphite);
    font-size: 19px;
    line-height: 29px;
    text-wrap: pretty;
  }
  .hero .actions {
    padding-top: 10px;
  }

  /* ---- how it fits together ---- */
  .how {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding-top: 144px;
  }
  .how-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: calc(780px + 2 * var(--gutter));
    padding-inline: var(--gutter);
    text-align: center;
  }
  .how h2 {
    color: var(--hairline);
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 50px;
    text-wrap: balance;
  }
  .lede {
    max-width: 660px;
    color: var(--graphite);
    font-size: var(--text-prose);
    line-height: 27px;
    text-wrap: pretty;
  }
  /* The orbit is drawn wider than the column: 1200px, shrinking below. */
  .figure {
    width: 100%;
    max-width: calc(var(--figure) + 2 * var(--gutter));
    padding-inline: var(--gutter);
  }

  /* ---- the four chapters ---- */
  .chapters {
    display: flex;
    flex-direction: column;
    gap: 128px;
    padding-block: 168px;
  }
  .chapter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .chapter.flip {
    flex-direction: row-reverse;
  }
  .chapter-copy {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 18px;
    width: 400px;
  }
  .chapter h2 {
    color: var(--hairline);
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 42px;
  }
  .chapter-body {
    color: var(--graphite);
    font-size: var(--text-prose);
    line-height: 27px;
  }
  .proof {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--rule);
    list-style: none;
  }
  .proof li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--hairline);
    font-size: var(--text-title);
    line-height: 22px;
  }
  .proof li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--hairline);
  }
  .chapter-stage {
    flex: 0 1 680px;
    min-width: 0;
  }

  /* ---- closing ---- */
  .closing {
    padding-bottom: 120px;
  }
  /*
   * The closing plate stays at its printed size and is cropped, not scaled:
   * the card on it reflows, so the install block stays legible at any width.
   */
  .closing-plate {
    display: flex;
    justify-content: center;
    min-height: 440px;
    padding: 60px 1rem 40px;
    background-image: var(--plate);
    background-position: center top;
    background-repeat: no-repeat;
    image-rendering: pixelated;
  }
  .close-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    width: 700px;
    max-width: 100%;
    align-self: flex-start;
    padding: 36px 40px;
    border: 1px solid var(--hairline);
    background: var(--paper);
    image-rendering: auto;
  }
  .close-card h2 {
    color: var(--hairline);
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 40px;
    text-align: center;
    text-wrap: balance;
  }
  .install {
    width: 100%;
    padding: 14px 16px;
    border: 0;
    background: var(--bone);
    color: var(--hairline);
    font-size: var(--text-ui);
    line-height: 21px;
  }
  /* A block cursor after the last command, blinking on a hard cut. */
  .install code::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1.1em;
    margin-left: 1px;
    background: var(--hairline);
    vertical-align: -0.2em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .closing-plate {
      animation: breathe 3.2s steps(1, end) infinite;
    }
    .install code::after {
      animation: blink 1.1s steps(1, end) infinite;
    }
  }
  @keyframes breathe {
    0% {
      background-image: var(--plate);
    }
    50% {
      background-image: var(--plate-b);
    }
    100% {
      background-image: var(--plate);
    }
  }
  @keyframes blink {
    50% {
      visibility: hidden;
    }
  }

  /* ---- narrower ---- */
  @media (max-width: 64rem) {
    .chapter,
    .chapter.flip {
      flex-direction: column;
      align-items: stretch;
      gap: 32px;
    }
    .chapter-copy {
      width: auto;
      max-width: 36rem;
    }
    .chapter-stage {
      flex: none;
    }
    .chapters {
      gap: 96px;
      padding-block: 120px;
    }
  }
  @media (max-width: 45rem) {
    .hero-copy {
      padding-block: 56px 40px;
    }
    .hero h1 {
      font-size: 40px;
      line-height: 46px;
    }
    .sub {
      font-size: var(--text-prose);
      line-height: 26px;
    }
    .how {
      padding-top: 96px;
    }
    .how h2 {
      font-size: 30px;
      line-height: 36px;
    }
    .chapter h2 {
      font-size: 28px;
      line-height: 34px;
    }
    .close-card {
      padding: 24px 16px;
    }
    .close-card h2 {
      font-size: 26px;
      line-height: 32px;
    }
  }
</style>
