---
import { FOOTER_LINE } from '../content/landing'
import { GITHUB, LICENSE } from '../links'

const links = [
  { href: '/docs', label: 'Docs' },
  { href: GITHUB, label: 'GitHub' },
  { href: LICENSE, label: 'AGPL-3.0' },
]
---

<footer class="foot">
  <div class="wrap row">
    <p class="brand">
      <img
        class="logo"
        style="--size:14px"
        src="/mark.svg"
        width="14"
        height="14"
        alt=""
      />
      <span>{FOOTER_LINE}</span>
    </p>
    <p class="meta mono">
      {
        links.map((l) => (
          <>
            <a href={l.href}>{l.label}</a>
            {' · '}
          </>
        ))
      }v0.1.0
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--rule);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 28px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--graphite);
    font-size: var(--text-ui);
    line-height: 16px;
  }
  .meta {
    color: var(--graphite);
    font-size: var(--text-label);
    line-height: 16px;
  }
  .meta a {
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--hairline);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
