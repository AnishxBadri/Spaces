---
import { FRAGMENT_ALT } from '../content/landing'
import type { Shot } from '../content/landing'
import { fragmentSize } from '../dither/stages'

interface Props {
  shot: Shot
  /** The hero's shots load with the page; every other stage's wait. */
  eager?: boolean
  /** Only the first hero shot is fetched ahead of everything else. */
  priority?: boolean
  z: number
}

const { shot, eager = false, priority = false, z } = Astro.props
const present = shot.fragment in __FRAGMENTS__
const { width, height } = fragmentSize(shot.fragment)
const alt = FRAGMENT_ALT[shot.fragment]
// The picture's width inside the frame and its padding, before any clip.
const inner = shot.clip?.full ?? shot.w - 2 * shot.pad - 2
const shown = shot.clip?.show ?? inner
const style = [
  `left:${shot.x}px`,
  `top:${shot.y}px`,
  `width:${shown + 2 * shot.pad + 2}px`,
  `padding:${shot.pad}px`,
  `z-index:${z}`,
].join(';')
---

<figure class="shot" style={style}>
  <div class="crop" style={`width:${shown}px`}>
    {
      present ? (
        <img
          src={`/screenshots/fragments/${shot.fragment}.webp`}
          width={width}
          height={height}
          alt={alt}
          style={`width:${inner}px`}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : undefined}
        />
      ) : (
        <div
          class="pending"
          role="img"
          aria-label={alt}
          style={`width:${inner}px;aspect-ratio:${width}/${height}`}
        >
          {shot.fragment}.png · pending
        </div>
      )
    }
  </div>
</figure>

<style>
  /*
   * A real screenshot on a stage: the crop in a 1px ink frame on paper, with
   * the padding the design draws around a crop whose text runs to its edge.
   * The frame is the only element on the page that moves under the pointer:
   * picked up, a hard ink offset, never a soft shadow.
   */
  .shot {
    position: absolute;
    border: 1px solid var(--hairline);
    background: var(--paper);
    transition:
      transform 120ms steps(2, end),
      box-shadow 120ms steps(2, end);
  }
  .crop {
    overflow: clip;
  }
  .crop img {
    max-width: none;
    height: auto;
  }
  .shot:hover {
    z-index: 20 !important;
    transform: translate(-2px, -2px);
    box-shadow: 3px 3px 0 0 var(--hairline);
  }

  .pending {
    display: grid;
    place-items: center;
    background: var(--bone);
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    /*
     * Shots settle in as they scroll into view: 14px up in six hard steps,
     * like a sheet feeding through a print head. Without scroll-driven
     * animations they are simply where they belong.
     */
    @supports (animation-timeline: view()) {
      .shot {
        animation: settle linear both;
        animation-timing-function: steps(6, end);
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }

  @keyframes settle {
    from {
      translate: 0 14px;
    }
    to {
      translate: 0 0;
    }
  }
</style>
