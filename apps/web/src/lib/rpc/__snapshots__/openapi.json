              "tag": {
                "type": "string",
                "enum": [
                  "Forbidden"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "tag",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
