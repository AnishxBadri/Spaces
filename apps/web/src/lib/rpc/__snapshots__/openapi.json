{
  "openapi": "3.1.0",
  "info": {
    "title": "Spaces",
    "version": "1"
  },
  "paths": {
    "/api/v1/capture/hello": {
      "get": {
        "tags": [
          "capture"
        ],
        "operationId": "capture.hello",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "integer"
                    },
                    "captureSchemaVersion": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "apiVersion",
                    "captureSchemaVersion"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "The API version (the v in /api/v1) and the capture payload schema version, so a client can tell \"update me\" from breakage.",
        "summary": "Version handshake"
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "session"
        ],
        "operationId": "session.me",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "email"
                      ],
                      "additionalProperties": false
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "capture:write",
                          "records:read",
                          "suggestions:write"
                        ]
                      }
                    }
                  },
                  "required": [
                    "user",
                    "scopes"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Answers for any live token, whatever its scopes. 401 for anything else, with no hint why.",
        "summary": "The token’s user and scopes"
      }
    }
  },
  "components": {
