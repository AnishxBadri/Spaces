{
  "openapi": "3.1.0",
  "info": {
    "title": "Spaces",
    "version": "1"
  },
  "paths": {
    "/api/v1/capture/hello": {
      "get": {
        "tags": [
          "capture"
        ],
        "operationId": "capture.hello",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "integer"
                    },
                    "captureSchemaVersion": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "apiVersion",
                    "captureSchemaVersion"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "The API version (the v in /api/v1) and the capture payload schema version, so a client can tell \"update me\" from breakage.",
        "summary": "Version handshake"
      }
    },
    "/api/v1/capture": {
      "post": {
        "tags": [
          "capture"
        ],
        "operationId": "capture.capture",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "description": "Where the capture shows in the app: the record it was filed on, or the unfiled inbox"
                    },
                    "extraction": {
                      "type": "string",
                      "enum": [
                        "queued",
                        "skipped"
                      ],
                      "description": "queued: the page will be read against the declared object and its suggestions land in the inbox. skipped: no object was declared, or no model is routed for the extract lane — the page is filed all the same."
                    }
                  },
                  "required": [
                    "documentId",
                    "url",
                    "extraction"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded"
                }
              }
            }
          },
          "404": {
            "description": "NotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundEncoded"
                }
              }
            }
          },
          "413": {
            "description": "PayloadTooLarge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayloadTooLargeEncoded"
                }
              }
            }
          },
          "422": {
            "description": "UnsupportedCaptureSchemaVersion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedCaptureSchemaVersionEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Files a page’s text as a document: a text/plain blob named by the title, with the page’s URL on the row, filed on the target record or left unfiled, extraction queued behind it. With `object` declared and the extract lane routed, the page is also read against that object’s fields and its suggestions land in the inbox, anchored on the page; `extraction` says whether that read was queued. Re-posting the same text to the same record answers the same document. Runs as the token’s user.",
        "summary": "Capture a page",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "captureSchemaVersion": {
                    "type": "integer",
                    "description": "The payload version the client was built for; capture.hello answers the one this instance speaks"
                  },
                  "url": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 400,
                    "description": "The page title; the document’s name"
                  },
                  "capturedAt": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string",
                    "description": "A record id, or a record’s exact name, to file the capture on; omit to leave it unfiled"
                  },
                  "object": {
                    "type": "string",
                    "description": "The registry object the page describes — person for a profile, company for a company page, or any object’s slug — to read it against that object’s fields; omit to file the page unread. An object the registry does not hold is refused."
                  }
                },
                "required": [
                  "captureSchemaVersion",
                  "url",
                  "title",
                  "capturedAt",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "session"
        ],
        "operationId": "session.me",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "email"
                      ],
                      "additionalProperties": false
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "capture:write",
                          "records:read",
                          "suggestions:write"
                        ]
                      }
                    }
                  },
                  "required": [
                    "user",
                    "scopes"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Answers for any live token, whatever its scopes. 401 for anything else, with no hint why.",
        "summary": "The token’s user and scopes"
      }
    },
    "/api/v1/registry": {
      "get": {
        "tags": [
          "registry"
        ],
        "operationId": "registry.list",
        "parameters": [],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "objects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "singular": {
                            "type": "string"
                          },
                          "plural": {
                            "type": "string"
                          },
                          "isSystem": {
                            "type": "boolean"
                          },
                          "identityKeys": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "attributes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "slug": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "description": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "type": {
                                  "type": "string"
                                },
                                "isSystem": {
                                  "type": "boolean"
                                },
                                "target": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "options": {
                                  "type": "object"
                                }
                              },
                              "required": [
                                "id",
                                "slug",
                                "name",
                                "description",
                                "type",
                                "isSystem",
                                "target",
                                "options"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "id",
                          "slug",
                          "singular",
                          "plural",
                          "isSystem",
                          "identityKeys",
                          "attributes"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "objects"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Every live object — companies, people, deals and each custom object — with its live attributes in registry order and their per-type config (select options, reference target, currency code). Read on every call: an object created a minute ago is listed. This is how a record’s `values`, keyed by attribute slug, are interpreted.",
        "summary": "Every object and its attributes"
      }
    },
    "/api/v1/objects/{object}/records": {
      "get": {
        "tags": [
          "records"
        ],
        "operationId": "records.list",
        "parameters": [
          {
            "name": "object",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "The previous page’s nextCursor, as it was handed out; omit for the first page"
            },
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Rows per page, an integer from 1 to 200; 50 when omitted"
            },
            "required": false
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "values": {
                            "type": "object"
                          },
                          "domains": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "emails": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "createdAt",
                          "values"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "object",
                    "rows",
                    "nextCursor",
                    "total"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded"
                }
              }
            }
          },
          "404": {
            "description": "NotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "The object by slug (or its singular or plural name). The same rows, in the same order, as the object’s list in the app with no view applied: newest first, keyset-paged on (created_at, id), so rows created or deleted while you page never repeat or skip another. Pass the previous page’s nextCursor to continue; null means the last page. No filter, search or sort parameter, by design.",
        "summary": "One page of an object’s records"
      }
    },
    "/api/v1/records/{id}": {
      "get": {
        "tags": [
          "records"
        ],
        "operationId": "records.get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "mergedFrom": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "object": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "slug": {
                              "type": "string"
                            },
                            "singular": {
                              "type": "string"
                            },
                            "plural": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "slug",
                            "singular",
                            "plural"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "values": {
                      "type": "object"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "direction": {
                            "type": "string",
                            "enum": [
                              "out",
                              "in"
                            ]
                          },
                          "relation": {
                            "type": "string"
                          },
                          "attrSlug": {
                            "type": "string"
                          },
                          "source": {
                            "type": "string"
                          },
                          "entity": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "kind",
                              "name"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "direction",
                          "relation",
                          "attrSlug",
                          "source",
                          "entity"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "spaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "name"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "name",
                    "mergedFrom",
                    "object",
                    "values",
                    "links",
                    "spaces"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "BadRequest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenEncoded"
                }
              }
            }
          },
          "404": {
            "description": "NotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundEncoded"
                }
              }
            }
          },
          "500": {
            "description": "InternalError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalErrorEncoded"
                }
              }
            }
          }
        },
        "description": "Its object, its values keyed by attribute slug, its links both ways and the spaces it is tagged into — as the token’s user may see it. A record that user may not read is not found.",
        "summary": "One record"
      }
    }
  },
