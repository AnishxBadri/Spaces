        },
      ],
      "filename": "acme-fusion.example__series-a-deck.pdf",
      "kind": "deck",
      "mime": "application/pdf",
    },
    "method": "fileDocument",
    "output": {
      "documentId": "document-1",
    },
    "port": "Content",
  },
  {
    "input": {
      "fields": {
        "documentId": "document-1",
        "filed": true,
        "filename": "acme-fusion.example__series-a-deck.pdf",
      },
      "message": "filed",
    },
    "method": "info",
    "output": undefined,
    "port": "Log",
  },
]
