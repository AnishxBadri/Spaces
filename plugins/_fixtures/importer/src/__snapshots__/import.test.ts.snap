exports[`the importer importDeck job, on the test Layers > resolves the company the filename names and files the deck against it 1`] = `
[
  {
    "input": {
      "keys": {
        "domain": "acme-fusion.example",
      },
      "kind": "company",
    },
    "method": "resolve",
    "output": {
      "entityId": "entity-acme",
      "outcome": "attached",
    },
    "port": "Identity",
  },
  {
    "input": {
      "_tag": "document",
      "body": {
        "stream": "<stream>",
      },
      "fileAgainst": [
        {
          "entityId": "entity-acme",
